{
  "name": "pairshot-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787 --persist-to .wrangler/state",
    "db:local": "wrangler d1 migrations apply pairshot --local --persist-to .wrangler/state",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "4.13.18",
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261112.1",
    "typescript": "~5.9.0",
    "vitest": "~4.1.0",
    "wrangler": "4.161.0"
  }
}
