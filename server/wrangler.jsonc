{
  // Pairshot server: client gallery pages, photo storage, CRM webhooks.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pairshot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [
    // The real Cloudflare database (local dev ignores the id).
    { "binding": "DB", "database_name": "pairshot", "database_id": "b3fdb886-a22c-4a44-b94f-4b6aadf29502", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "pairshot-photos" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Test mode: sign in without Google, "Pretend Pro" works. Set "false" once GOOGLE_CLIENT_ID is filled in
    // (docs/google-sign-in.md). `npm run dev` and the tests always run in test mode.
    "DEV_MODE": "false",
    "GOOGLE_CLIENT_ID": "118026851240-ucj9denba83declo3r8p6521ok1ibc2q.apps.googleusercontent.com",
    // Free uploads pause when everything stored passes this (bytes). 10 GB = R2's free allowance.
    "FREE_STORAGE_BRAKE_BYTES": "10737418240",
    // Buying Pro: the Play package and product. The service account key is a secret
    // (`npx wrangler secret put PLAY_SERVICE_ACCOUNT`, see docs/play-billing.md).
    "PLAY_PACKAGE": "com.greasepencil.pairshot",
    "PRO_PRODUCT_ID": "pro"
  }
}
